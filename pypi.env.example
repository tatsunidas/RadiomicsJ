# Template for the PyPI credentials used by twine.
#
# HOW TO USE
#   1) copy this file, and keep the copy out of git
#        cp pypi.env.example pypi.env
#        chmod 600 pypi.env
#   2) put your API token into pypi.env (it starts with "pypi-")
#        https://pypi.org/manage/account/token/
#   3) load it, then upload
#        set -a; . ./pypi.env; set +a
#        python3 -m build            # run in target/radiomicsj-python
#        python3 -m twine upload --verbose dist/*
#
# "pypi.env" and ".pypirc" are listed in .gitignore.
# NEVER commit the real token. If it leaks, revoke it on pypi.org immediately.
#
# The token is the password itself, so the user name is always the literal
# string "__token__".

TWINE_USERNAME=__token__
TWINE_PASSWORD=pypi-PUT-YOUR-API-TOKEN-HERE

# Upload to TestPyPI instead, when you want a rehearsal.
# The token of TestPyPI is a different one.
#TWINE_REPOSITORY_URL=https://test.pypi.org/legacy/

# This machine uploads about 300 KB/s, and the package is about 22 MB,
# so a full upload takes over a minute. Raise the timeout if it is cut off.
#TWINE_NON_INTERACTIVE=1
